{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits",
    ":automergeStableNonMajor",
    ":automergeRequireAllStatusChecks",
    ":configMigration",
    ":enableVulnerabilityAlertsWithLabel(security)",
    ":label(dependencies)",
    ":maintainLockFilesWeekly",
    ":rebaseStalePrs",
    "helpers:pinGitHubActionDigests"
  ],
  "enabledManagers": [
    "pep621",
    "github-actions",
    "pre-commit",
    "dockerfile"
  ],
  "prHourlyLimit": 5,
  "prConcurrentLimit": 5,
  "schedule": [
    "before 9am on Monday"
  ],
  "timezone": "Europe/London",
  "packageRules": [
    {
      "description": "Python dependencies: one PR for every non-major update.",
      "matchManagers": [
        "pep621"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Python dependencies",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps"
    },
    {
      "description": "GitHub Actions: grouped, with a ci type so the labeller files them under CI/CD.",
      "matchManagers": [
        "github-actions"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "GitHub Actions",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "pre-commit hooks: grouped, keeping the frozen SHA pins.",
      "matchManagers": [
        "pre-commit"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "groupName": "pre-commit hooks",
      "semanticCommitType": "ci",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Docker base images (Dockerfile): digest and patch bumps grouped and automerged, as build changes. Images are pinned by tag and digest.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchUpdateTypes": [
        "patch",
        "digest",
        "pin",
        "pinDigest"
      ],
      "groupName": "Docker images",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "A new Python (3.14 to 3.15) in the Dockerfile is a manual change: requires-python and CI's Python move with it.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "groupName": "Python interpreter",
      "automerge": false,
      "semanticCommitType": "build",
      "semanticCommitScope": "deps",
      "labels": [
        "dependencies",
        "python-version"
      ]
    },
    {
      "description": "uv in the Dockerfile: any update, grouped with the other images and automerged once CI's image build and smoke test pass.",
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "ghcr.io/astral-sh/uv"
      ],
      "groupName": "Docker images",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    },
    {
      "description": "hatchling, hatch-vcs and calver-scm sit in build-system.requires and in the release group; move them together (as in menagerist).",
      "matchManagers": [
        "pep621"
      ],
      "matchPackageNames": [
        "hatchling",
        "hatch-vcs",
        "calver-scm"
      ],
      "groupName": "Python build system",
      "semanticCommitType": "build",
      "semanticCommitScope": "deps"
    }
  ]
}
