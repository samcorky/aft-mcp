# aft-mcp settings. Generated by `uv run poe settings-docs`; do not edit.
# Copy to ~/.config/aft-mcp/.env (or a file named by AFT_MCP_ENV_FILE)
# and fill in the settings that aren't commented out.
# Every variable is described in docs/settings.md.

# --- Connecting to AFT ---

# Base URL the generated tools call. It must use https unless AFT_MCP_ALLOW_INSECURE is
# set.
# Allowed: http:// or https://.
# Required: yes.
AFT_MCP_BASE_URL=https://aft.example.com

# URL of AFT's Swagger 2.0 or OpenAPI spec, which the tools are built from. Unset, it is
# api/apispec.json under AFT_MCP_BASE_URL. It must be on the same host and port as
# AFT_MCP_BASE_URL, and so must any redirect it follows.
# Allowed: http:// or https://.
# AFT_MCP_SPEC_URL=https://aft.example.com/api/apispec.json

# Load the spec from this local file instead of AFT_MCP_SPEC_URL.
# AFT_MCP_SPEC_FILE=

# Request timeout in seconds, for the spec and every tool call.
# Allowed: more than 0.
# AFT_MCP_TIMEOUT=30

# Allow http:// for AFT_MCP_BASE_URL and AFT_MCP_SPEC_URL, for an AFT on a trusted
# network or VPN. The credentials are then sent unencrypted, and the server warns about
# it on every start.
# AFT_MCP_ALLOW_INSECURE=false

# --- Signing in ---

# AFT API token, sent as Authorization: Bearer (recommended). Create it on an API-only
# user; set this, or both AFT_MCP_USERNAME and AFT_MCP_PASSWORD. It is never shown in
# reprs, logs or errors.
# Allowed: not empty.
# Sensitive: no value is written here.
# AFT_MCP_TOKEN=

# AFT account email or username, sent as HTTP basic auth, for AFT versions without API
# tokens. Needs AFT_MCP_PASSWORD; not with AFT_MCP_TOKEN. Use a dedicated user for the
# agent, not your own account.
# Allowed: not empty.
# AFT_MCP_USERNAME=agent@example.com

# Password of the AFT_MCP_USERNAME account. It is never shown in reprs, logs or errors.
# Allowed: not empty.
# Sensitive: no value is written here.
# AFT_MCP_PASSWORD=

# --- What the tools may do ---

# Expose only the safe reads, so no tool can change anything.
# AFT_MCP_READ_ONLY=false

# Only let the tools reach these boards; unset allows every board the AFT user can see.
# Allowed: each more than 0.
# AFT_MCP_BOARD_IDS=12,15

# A short name for this AFT instance, such as prod or test. It is added to the server's
# name and instructions, so the agent knows which instance it is changing, and to every
# log line.
# AFT_MCP_INSTANCE=prod

# --- Logging ---

# How the log is written: logfmt lines, or one JSON object per line for log pipelines.
# Allowed: logfmt or json.
# AFT_MCP_LOG_FORMAT=json

# Write the log to stderr. Over SSH, stderr goes back to the client, so a server can set
# this to false and keep the log in syslog instead.
# AFT_MCP_LOG_STDERR=true

# Also send the log to the local syslog (/dev/log), so a server keeps the audit trail
# itself. A missing socket stops the server.
# AFT_MCP_LOG_SYSLOG=false

# Syslog facility for the log; auth or authpriv puts it next to sshd's lines.
# Allowed: user or auth or authpriv or daemon or local0 or local1 or local2 or local3 or
# local4 or local5 or local6 or local7.
# AFT_MCP_LOG_SYSLOG_FACILITY=auth
