# Base URL the generated tools call
AFT_BASE_URL=https://aft.example.com
# Swagger 2.0 / OpenAPI spec to build the tools from
AFT_SPEC_URL=https://aft.example.com/api/apispec.json
# Request timeout in seconds
AFT_TIMEOUT=30
# Credentials sent as HTTP basic auth (username is your AFT email)
AFT_USERNAME=you@example.com
AFT_PASSWORD=change-me
# Optional: load the spec from a local file instead of AFT_SPEC_URL
# AFT_SPEC_FILE=aft-openapi.json
# Optional: expose only the safe reads, no writes
# AFT_READ_ONLY=true
# Optional: only let the tools reach these boards (comma-separated ids)
# AFT_BOARD_IDS=12,15
# Optional: write the audit log on stderr as logfmt (default) or json
# AFT_LOG_FORMAT=json
